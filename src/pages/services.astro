---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CTASection from '@components/CTASection.astro';
import { featuredServices, serviceCategories } from '@data/services';

const title = 'Business Compliance Services | GST, Tax, ROC, FSSAI & Registrations';
const description =
  'Explore GST registration, company incorporation, income tax filing, FSSAI registration, Startup India, MSME, GeM, IEC, ROC filing, and other compliance services.';
---

<BaseLayout title={title} description={description}>
  <section class="bg-mist py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Services"
        title="Business Registration, Tax Filing & Compliance Services"
        description="Practical support for founders, freelancers, small businesses, e-commerce sellers, and growing companies across India."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featuredServices.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            href={`/${service.slug}`}
            price={service.price}
            category={service.category}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="Complete Service Coverage" description="Service groups are organized so you can quickly find the right compliance support." />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {serviceCategories.map((category) => (
          <article class="rounded border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-bold text-navy-900">{category.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">{category.description}</p>
            <ul class="mt-5 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
              {category.services.map((service) => <li class="font-semibold">• {service}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Need help choosing the right service?" description="Send your requirement on WhatsApp and we will guide you on the correct registration, filing, or compliance path." />
</BaseLayout>
