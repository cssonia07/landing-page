---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PricingCard from '@components/PricingCard.astro';
import CTASection from '@components/CTASection.astro';
import { generalDocuments } from '@data/services';
import { pricing } from '@data/pricing';

const title = 'Pricing | GST, Company Registration, Tax Filing & Compliance Services';
const description =
  'View starting prices for GST registration, company incorporation, tax filing, FSSAI, Startup India, GeM, IEC, ROC filings, trademark, and compliance services.';
---

<BaseLayout title={title} description={description}>
  <section class="bg-mist py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Pricing"
        title="Transparent Starting Prices"
        description="Use these as starting prices on the website. Final pricing should depend on entity type, state, number of directors or partners, document condition, and government fees."
      />
      <p class="mt-6 rounded border border-accent-500/30 bg-white p-4 text-sm font-semibold leading-7 text-slate-700">
        *Government fees and third-party charges extra wherever applicable.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pricing.map((item) => <PricingCard {...item} />)}
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <SectionHeading
        eyebrow="Documents"
        title="Documents Required"
        description="Basic documents are enough to begin the first review. Service-specific lists are shared after understanding your requirement."
      />
      <div class="grid gap-3 sm:grid-cols-2">
        {generalDocuments.map((document) => (
          <div class="rounded border border-slate-200 bg-white p-4 text-sm font-semibold text-slate-700 shadow-sm">{document}</div>
        ))}
        <div class="rounded border border-navy-200 bg-navy-50 p-4 text-sm font-semibold leading-6 text-navy-900 sm:col-span-2">
          We share the exact checklist after reviewing your requirement, so you do not upload unnecessary papers.
        </div>
      </div>
    </div>
  </section>

  <CTASection title="Want a service-specific quote?" description="Share your business type and requirement so we can confirm scope, documents, timeline, and final pricing." />
</BaseLayout>
