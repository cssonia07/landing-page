---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import AboutSection from '@components/AboutSection.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServicesGrid from '@components/ServicesGrid.astro';
import TestimonialCard from '@components/TestimonialCard.astro';
import FAQAccordion from '@components/FAQAccordion.astro';
import CTASection from '@components/CTASection.astro';
import ContactForm from '@components/ContactForm.astro';
import { faqs } from '@data/faqs';
import { featuredServices, processSteps, serviceCategories, whoWeHelp, whyChooseUs } from '@data/services';
import { testimonials } from '@data/testimonials';

const title = 'NiyamDesk by Sonia Gupta & Associates | GST, Company Registration & Compliance Services';
const description =
  'NiyamDesk is operated by Sonia Gupta & Associates, a Practicing Company Secretary firm providing GST registration, company incorporation, income tax filing, FSSAI, Startup India, GeM, IEC, ROC filing, and business compliance services across India.';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>
  <Hero
    title="Business Compliance Made Clear for Indian Entrepreneurs"
    description="NiyamDesk by Sonia Gupta & Associates helps startups, small businesses, freelancers, and entrepreneurs manage registrations, filings, and compliance requirements with clear guidance and professional support."
  />

  <AboutSection
    title="About NiyamDesk"
    description="NiyamDesk is the online platform of Sonia Gupta & Associates, a Practicing Company Secretary firm established on 11th May 2017 by PCS Sonia Gupta."
    body={[
      'Through NiyamDesk, Sonia Gupta & Associates helps startups, entrepreneurs, freelancers, and businesses handle registration, taxation, and compliance work in a simple, professional, and structured manner.',
      'We support clients with GST services, company incorporation, income tax filings, FSSAI registration, Startup India registration, MSME/Udyam, GeM registration, IEC registration, ROC compliance, trademark registration, FEMA compliance, and other business requirements.'
    ]}
    highlightTitle="Our Approach"
    highlightText="Clear communication. Timely filings. Accurate documentation. Practical advice. Ongoing support."
    highlights={whoWeHelp.map((item) => ({ title: item }))}
    background="white"
  />

  <ServicesGrid
    eyebrow="Services"
    title="Registration, Taxation & Compliance Support"
    description="Choose focused support for one requirement or ongoing compliance assistance for your business."
    services={featuredServices}
    limit={6}
    ctaHref="/services"
    ctaLabel="View All Services"
    background="soft"
  />

  <section class="bg-white section-pad">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Coverage" title="Service Categories" />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {serviceCategories.map((category) => (
          <article class="premium-card premium-card-hover p-6">
            <h3 class="text-xl font-bold text-navy-900">{category.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{category.description}</p>
            <ul class="mt-5 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
              {category.services.map((service) => <li class="font-semibold">• {service}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist section-pad">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Our Process" title="How It Works" />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, index) => (
          <article class="premium-card premium-card-hover p-5">
            <span class="inline-flex rounded-full bg-accent-50 px-3 py-1 text-sm font-bold text-accent-600">Step {index + 1}</span>
            <h3 class="mt-2 text-lg font-bold text-navy-900">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white section-pad">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Why Choose Us" title="Why Clients Work With Us" />
      <div class="mt-10 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {whyChooseUs.map((point) => (
          <div class="premium-card premium-card-hover p-4 text-sm font-semibold leading-6 text-slate-700">
            {point}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist section-pad">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Client Feedback"
        title="Client Feedback"
        description="We believe in genuine client relationships and professional support. The feedback below reflects real experiences shared by our clients."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {testimonials.map((testimonial) => <TestimonialCard {...testimonial} />)}
      </div>
    </div>
  </section>

  <section class="bg-white section-pad">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <SectionHeading eyebrow="FAQ" title="Frequently Asked Questions" description="A few common questions before you start a filing, registration, or compliance engagement." />
      <FAQAccordion items={faqs} />
    </div>
  </section>

  <section class="bg-mist section-pad">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div>
        <SectionHeading
          eyebrow="Contact"
          title="Book a Consultation Today"
          description="Share your requirement and we will tell you the exact process, documents, and pricing."
        />
      </div>
      <ContactForm />
    </div>
  </section>

  <CTASection />
</BaseLayout>
