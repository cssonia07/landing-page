---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import CTASection from '@components/CTASection.astro';
import { site } from '@data/site';

const title = 'About Sonia Gupta & Associates | Practicing Company Secretary Firm';
const description =
  'Learn about Sonia Gupta & Associates, a Practicing Company Secretary firm established in 2017 providing business registration, tax filing and compliance support in India.';

const services = [
  'GST Registration',
  'GST Return Filing',
  'GST Notice Support',
  'GST Amendments and Cancellation',
  'Private Limited Company Registration',
  'LLP Registration',
  'OPC Registration',
  'Partnership Firm Registration',
  'Income Tax Return Filing',
  'Tax Consultation',
  'Business Tax Compliance',
  'FSSAI Registration and Licensing',
  'Startup India Registration',
  'MSME/Udyam Registration',
  'GeM Registration',
  'IEC Registration',
  'ROC Filings',
  'Annual Returns',
  'Compliance Management',
  'Documentation Support',
  'FEMA Compliance',
  'Trademark Application Support',
  'Accounting and Bookkeeping Support',
  'Other business compliance services'
];

const audiences = [
  {
    title: 'Startups',
    text: 'For founders who need the right business structure, startup registration, tax compliance and ongoing filing support.'
  },
  {
    title: 'Small Businesses',
    text: 'For traders, manufacturers, service providers and local businesses that need reliable registration and compliance assistance.'
  },
  {
    title: 'Freelancers and Professionals',
    text: 'For individuals who need GST, income tax, business setup or compliance guidance.'
  },
  {
    title: 'E-commerce Sellers',
    text: 'For sellers who need GST, MSME, GeM, IEC, tax filing and business documentation support.'
  },
  {
    title: 'Growing Companies',
    text: 'For companies and LLPs that need annual compliance, ROC filings, tax support and documentation management.'
  }
];

const why = [
  {
    title: 'Professional Expertise',
    text: 'We bring practical experience in business registration, corporate compliance and statutory filings.'
  },
  {
    title: 'Clear Communication',
    text: 'We explain the process, documents, fees and expected timeline in simple language.'
  },
  {
    title: 'Transparent Process',
    text: 'Clients are guided step by step, from inquiry to documentation to filing and completion.'
  },
  {
    title: 'Personal Attention',
    text: 'We do not treat compliance as a mechanical form-filing activity. We understand the client’s business need before suggesting the right service.'
  },
  {
    title: 'Online Convenience',
    text: 'Most services can be handled through phone, email, WhatsApp and online document sharing.'
  },
  {
    title: 'Long-Term Support',
    text: 'We help not only with registration but also with future filings, returns, renewals and compliance management.'
  }
];

const approach = [
  {
    title: 'Understand the Requirement',
    text: 'We first understand your business, service requirement and current compliance status.'
  },
  {
    title: 'Share the Process Clearly',
    text: 'We explain the process, documents required, estimated timeline and professional fees.'
  },
  {
    title: 'Review Documents',
    text: 'We check the documents before filing to reduce avoidable errors and delays.'
  },
  {
    title: 'Complete Filing or Registration',
    text: 'We prepare and submit the required application, return, form or document.'
  },
  {
    title: 'Provide Updates and Support',
    text: 'We keep you informed and guide you if any additional query or action is required.'
  }
];

const values = [
  'Professional integrity',
  'Practical advice',
  'Timely communication',
  'Client confidentiality',
  'Transparent fees',
  'Accuracy in documentation',
  'Long-term client relationships'
];

const trust = [
  'Practicing Company Secretary Firm',
  'Established in 2017',
  'Online Support Across India',
  'Transparent Process',
  'Professional Documentation',
  'Client Confidentiality'
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about` }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': ['Organization', 'ProfessionalService'],
    name: site.name,
    url: site.url,
    email: site.email,
    telephone: `+91${site.phone}`,
    foundingDate: site.established,
    founder: {
      '@type': 'Person',
      name: 'PCS Sonia Gupta'
    },
    areaServed: 'India'
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="bg-mist py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <p class="text-sm font-bold uppercase tracking-wide text-accent-600">About Us</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight tracking-normal text-navy-900 sm:text-5xl">About Sonia Gupta & Associates</h1>
        <p class="mt-5 text-xl font-semibold leading-8 text-navy-800">Simplifying Business Registration, Tax Filing and Compliance for Indian Businesses</p>
        <div class="mt-6 space-y-5 text-base leading-8 text-slate-600">
          <p>Sonia Gupta & Associates is a firm of Practicing Company Secretaries established on <strong>11th May 2017</strong> by <strong>PCS Sonia Gupta</strong>.</p>
          <p>We provide professional support to startups, entrepreneurs, freelancers, e-commerce sellers, small businesses and growing companies for business registration, tax filing, compliance management and related legal documentation.</p>
          <p>Our goal is simple: to make business compliance easier to understand, easier to manage and easier to complete.</p>
          <p>Many business owners know they need registrations, filings and compliance support, but they do not know where to start, which documents are required, how much it will cost or what happens after registration. We help bridge that gap with clear communication, practical guidance and structured professional support.</p>
        </div>
      </div>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {trust.map((point) => <div class="rounded border border-slate-200 bg-white p-4 text-sm font-bold text-navy-900 shadow-sm">{point}</div>)}
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="Our Mission" />
      <div class="mt-6 max-w-4xl space-y-5 text-base leading-8 text-slate-600">
        <p>Our mission is to help Indian businesses stay legally compliant without confusion, delay or unnecessary complexity.</p>
        <p>We aim to provide reliable, transparent and practical support for registration, taxation and compliance needs so business owners can focus on running and growing their business.</p>
      </div>
    </div>
  </section>

  <section class="bg-mist py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="What We Do" description="We support clients with a wide range of professional services, including:" />
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <div class="rounded border border-slate-200 bg-white p-4 text-sm font-semibold text-slate-700 shadow-sm">{service}</div>)}
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="Who We Serve" description="We work with:" />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {audiences.map((item) => (
          <article class="rounded border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-bold text-navy-900">{item.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="Why Clients Choose Us" />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {why.map((item) => (
          <article class="rounded border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-bold text-navy-900">{item.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="Our Working Approach" />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-5">
        {approach.map((step, index) => (
          <article class="rounded border border-slate-200 bg-white p-5 shadow-sm">
            <span class="text-sm font-bold text-accent-600">{index + 1}</span>
            <h2 class="mt-2 text-lg font-bold text-navy-900">{step.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist py-16">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div>
        <SectionHeading title="Our Values" />
        <ul class="mt-8 grid gap-3">
          {values.map((value) => <li class="rounded border border-slate-200 bg-white p-4 text-sm font-bold text-slate-700 shadow-sm">{value}</li>)}
        </ul>
      </div>
      <article class="rounded border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-navy-900">Founder Note</h2>
        <div class="mt-5 space-y-5 text-base leading-8 text-slate-600">
          <p>Starting and running a business in India can feel complicated because there are many registrations, filings, tax requirements and compliance deadlines. Most business owners do not need complicated explanations. They need clear guidance, correct documentation and timely support.</p>
          <p>At Sonia Gupta & Associates, our focus is to make compliance simple, structured and dependable for every client.</p>
          <p class="font-bold text-navy-900">— PCS Sonia Gupta</p>
        </div>
      </article>
    </div>
  </section>

  <CTASection title="Need help with registration, tax filing or compliance?" description="Book a consultation today and get clear guidance for your business requirement." />
</BaseLayout>
