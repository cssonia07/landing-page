---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ContactForm from '@components/ContactForm.astro';
import CTASection from '@components/CTASection.astro';
import { serviceWhatsAppUrl, site } from '@data/site';

const title = 'Contact NiyamDesk | Business Registration & Compliance Help';
const description =
  'Contact NiyamDesk, operated by Sonia Gupta & Associates, for GST registration, company registration, income tax filing, FSSAI, Startup India, GeM, IEC, ROC, trademark and FEMA compliance services.';

const process = [
  {
    title: 'Requirement Review',
    text: 'We review your message and understand your business requirement.'
  },
  {
    title: 'Document Checklist',
    text: 'We share the documents required for the selected service.'
  },
  {
    title: 'Fee and Timeline Confirmation',
    text: 'We explain the professional fee, government charges if applicable, and estimated timeline.'
  },
  {
    title: 'Service Execution',
    text: 'After confirmation and payment, we begin the work and keep you updated.'
  }
];

const trust = [
  'Professional Compliance Support',
  'Built for Indian Businesses',
  'Online Support Across India',
  'Transparent Process',
  'Professional Documentation',
  'Client Confidentiality'
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact` }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: `${site.url}/contact`,
    mainEntity: {
      '@type': 'ProfessionalService',
      name: site.firmName,
      alternateName: site.name,
      brand: site.name,
      telephone: `+91${site.phone}`,
      email: site.email,
      url: site.url,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Noida',
        addressRegion: 'UP',
        postalCode: '201307',
        addressCountry: 'IN'
      },
      areaServed: 'India'
    }
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="bg-mist section-pad">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8">
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-teal-700">Contact Us</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight tracking-normal text-navy-900 sm:text-5xl">Contact Us</h1>
        <h2 class="mt-5 text-xl font-bold leading-8 text-navy-800">Need Help With Business Registration, Tax Filing or Compliance?</h2>
        <div class="mt-6 space-y-5 text-base leading-8 text-slate-600">
          <p>If you are starting a business, managing GST, filing income tax, completing ROC compliance, applying for FSSAI, Startup India, MSME/Udyam, GeM, IEC, trademark registration or FEMA compliance, you can contact us for professional support.</p>
          <p>Share your requirement and we will guide you with the process, documents, timeline and pricing.</p>
        </div>
        <div class="mt-8 grid gap-3 text-sm text-slate-700">
          <div class="premium-card p-4 font-semibold">Brand Name: {site.name}</div>
          <div class="premium-card p-4 font-semibold">Operated By: {site.firmName}</div>
          <div class="premium-card p-4 font-semibold">Website: {site.domain}</div>
          <a href={site.phoneHref} class="premium-card p-4 font-semibold transition hover:border-teal-500/40 hover:text-teal-700">Phone: {site.phone}</a>
          <a href={serviceWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="premium-card p-4 font-semibold transition hover:border-teal-500/40 hover:text-teal-700">
            WhatsApp: {site.whatsapp}
          </a>
          <a href={site.emailHref} class="premium-card p-4 font-semibold transition hover:border-teal-500/40 hover:text-teal-700">Email: {site.email}</a>
          <div class="premium-card p-4 font-semibold">Location: {site.location}</div>
          <div class="premium-card p-4 font-semibold">Service Area: Online support across India</div>
          <div class="premium-card p-4 font-semibold">Working Days: Monday to Saturday</div>
          <div class="premium-card p-4 font-semibold">Working Hours: 10:00 AM to 6:00 PM</div>
        </div>
      </div>
      <div>
        <div class="mb-4">
          <SectionHeading title="Inquiry Form" description="Use this form to share your requirement. Our team will review your message and contact you." />
        </div>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="bg-white section-pad">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading title="What Happens After You Contact Us?" />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {process.map((step, index) => (
          <article class="premium-card premium-card-hover p-5">
            <span class="inline-flex rounded-full bg-accent-50 px-3 py-1 text-sm font-bold text-accent-600">Step {index + 1}</span>
            <h2 class="mt-2 text-lg font-bold text-navy-900">{step.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-mist section-pad">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <div>
        <SectionHeading title="Service Area" description="NiyamDesk supports clients online across India, so you can start with a call, email, or WhatsApp message from your city." />
        <p class="mt-6 rounded-xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-700 shadow-sm">Location: {site.location}</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a href={site.phoneHref} class="btn-secondary">Book Consultation</a>
          <a href={serviceWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Talk on WhatsApp</a>
        </div>
      </div>
      <div class="premium-card p-6">
        <h2 class="text-2xl font-bold text-navy-900">Important Note</h2>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          Please do not share highly sensitive documents through the contact form unless requested. Once your requirement is reviewed, we will guide you on the correct document submission process.
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {trust.map((item) => <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm font-bold text-slate-700">{item}</div>)}
        </div>
      </div>
    </div>
  </section>

  <CTASection title="Not sure which service you need?" description="Send us your basic business details and we will guide you with the right registration or compliance requirement." />
</BaseLayout>
