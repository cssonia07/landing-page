---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CTASection from '@components/CTASection.astro';
import { site } from '@data/site';

const title = 'Business Compliance Blog | GST, Tax & Registration Articles | NiyamDesk';
const description =
  'Read simple articles from NiyamDesk on GST registration, GST filing, business registration, tax compliance, and related compliance topics for Indian businesses.';

const articles = [
  {
    title: 'Who Should Take GST Registration in India?',
    description:
      'Understand who needs GST registration in India, turnover limits, mandatory registration cases, e-commerce rules, documents, and consequences of delay.',
    href: '/blog/who-should-take-gst-registration-in-india',
    category: 'GST',
    date: '13 June 2026'
  }
];

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'NiyamDesk Blog',
  url: `${site.url}/blog`,
  publisher: {
    '@type': 'Organization',
    name: site.firmName,
    alternateName: site.name
  }
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="bg-mist section-pad">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-wide text-teal-700">Articles</p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-normal text-navy-900 md:text-5xl">
          Business Compliance Blog
        </h1>
        <p class="mt-5 text-base leading-8 text-slate-600">
          Simple, practical articles on GST, tax, business registration, and compliance topics for Indian business owners, freelancers, startups, and professionals.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <article class="premium-card premium-card-hover p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-teal-700">{article.category}</p>
            <h2 class="mt-3 text-xl font-bold leading-snug text-navy-900">
              <a href={article.href} class="hover:text-teal-700">{article.title}</a>
            </h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">{article.description}</p>
            <div class="mt-5 flex items-center justify-between gap-4">
              <span class="text-xs font-semibold text-slate-500">{article.date}</span>
              <a href={article.href} class="text-sm font-bold text-teal-700 hover:text-teal-800">Read article</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Need help with GST or business compliance?" description="Contact NiyamDesk for clear guidance on registration, filing, notices, and compliance support." />
</BaseLayout>
