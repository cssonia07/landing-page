---
import { encodedWhatsAppUrl } from '@data/site';

interface Props {
  title: string;
  description: string;
  href?: string;
  price?: string;
  category?: string;
}

const { title, description, href, price, category } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-teal-500/40 hover:shadow-soft">
  <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-lg font-bold text-teal-700">
    {title.charAt(0)}
  </div>
  {category && <p class="inline-flex w-fit rounded-full bg-teal-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-teal-700">{category}</p>}
  <h3 class="mt-3 text-lg font-bold leading-snug text-navy-900">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{description}</p>
  {price && <p class="mt-4 border-l-4 border-accent-500 pl-3 text-sm font-bold text-navy-900">{price}</p>}
  <div class="mt-5 flex flex-wrap gap-2">
    {href && <a href={href} class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold text-navy-900 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-700">Learn More</a>}
    <a href={encodedWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-teal-500 px-3 py-2 text-sm font-bold text-white transition hover:bg-teal-600">
      WhatsApp
    </a>
  </div>
</article>
