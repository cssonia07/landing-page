---
import { encodedWhatsAppUrl } from '@data/site';

interface Props {
  title: string;
  description: string;
  href?: string;
  price?: string;
  category?: string;
}

const { title, description, href, price, category } = Astro.props;
---

<article class="flex h-full flex-col rounded border border-slate-200 bg-white p-5 shadow-sm">
  {category && <p class="text-xs font-bold uppercase tracking-wide text-accent-600">{category}</p>}
  <h3 class="mt-2 text-lg font-bold leading-snug text-navy-900">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{description}</p>
  {price && <p class="mt-4 text-sm font-bold text-navy-800">{price}</p>}
  <div class="mt-5 flex flex-wrap gap-2">
    {href && <a href={href} class="rounded border border-slate-300 px-3 py-2 text-sm font-bold text-navy-900 hover:bg-slate-50">View Details</a>}
    <a href={encodedWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="rounded bg-navy-900 px-3 py-2 text-sm font-bold text-white hover:bg-navy-800">
      WhatsApp
    </a>
  </div>
</article>
