---
interface Props {
  documents: string[];
}

const { documents } = Astro.props;
---

<section class="rounded border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-2xl font-bold tracking-normal text-navy-900">Documents Required</h2>
  <ul class="mt-5 grid gap-3 text-sm leading-6 text-slate-700 sm:grid-cols-2">
    {documents.map((document) => (
      <li class="rounded border border-slate-200 bg-slate-50 p-3 font-semibold">{document}</li>
    ))}
  </ul>
</section>
