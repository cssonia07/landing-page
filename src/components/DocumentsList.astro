---
interface Props {
  documents: string[];
}

const { documents } = Astro.props;
---

<section class="premium-card p-6">
  <h2 class="text-2xl font-bold tracking-normal text-navy-900">Documents Required</h2>
  <ul class="mt-5 grid gap-3 text-sm leading-6 text-slate-700 sm:grid-cols-2">
    {documents.map((document) => (
      <li class="rounded-lg border border-slate-200 bg-slate-50 p-3 font-semibold transition hover:border-teal-500/40 hover:bg-teal-50/60">{document}</li>
    ))}
  </ul>
</section>
