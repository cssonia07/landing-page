---
import { encodedWhatsAppUrl } from '@data/site';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = 'Business Compliance Services in India',
  title,
  description,
  primaryLabel = 'Book Consultation',
  primaryHref = '/contact',
  secondaryLabel = 'Talk on WhatsApp',
  secondaryHref = encodedWhatsAppUrl
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-white via-mist to-teal-50">
  <div class="pointer-events-none absolute -left-24 top-24 h-72 w-72 rounded-full bg-teal-100/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-20 bottom-10 h-72 w-72 rounded-full bg-slate-300/40 blur-3xl"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8 lg:py-28">
    <div class="flex flex-col justify-center">
      <p class="text-sm font-bold uppercase tracking-wide text-teal-700">{eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal text-navy-900 sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">{description}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={primaryHref} class="btn-primary">
          {primaryLabel}
        </a>
        <a href={secondaryHref} target={secondaryHref.startsWith('http') ? '_blank' : undefined} rel={secondaryHref.startsWith('http') ? 'noopener noreferrer' : undefined} class="btn-secondary">
          {secondaryLabel}
        </a>
      </div>
      <p class="mt-6 text-sm font-semibold leading-7 text-slate-600">
        Clear process. Transparent pricing. Practical guidance. Reliable support for startups, freelancers, and growing businesses.
      </p>
    </div>
    <div class="relative grid content-center">
      <div class="pointer-events-none absolute -left-8 -top-8 h-40 w-40 rounded-full bg-teal-200/25 blur-2xl"></div>
      <div class="pointer-events-none absolute -bottom-8 -right-8 h-44 w-44 rounded-full bg-accent-100/40 blur-2xl"></div>
      <div class="premium-card relative rounded-2xl border-slate-100 p-6 shadow-soft sm:p-8">
        <h2 class="text-xl font-bold text-navy-900">Services at a glance</h2>
        <div class="mt-5 grid gap-3 text-sm text-slate-700 sm:grid-cols-2">
          {['GST', 'Company Registration', 'Income Tax', 'FSSAI', 'Startup India', 'MSME/Udyam', 'GeM', 'ROC Filings'].map((item) => (
            <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-semibold transition hover:border-teal-500/40 hover:bg-teal-50">
              <span class="mr-2 text-teal-600">✓</span>{item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
