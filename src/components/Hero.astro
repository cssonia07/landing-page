---
import { encodedWhatsAppUrl } from '@data/site';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = 'Business Compliance Services in India',
  title,
  description,
  primaryLabel = 'Book Consultation',
  primaryHref = '/contact',
  secondaryLabel = 'Talk on WhatsApp',
  secondaryHref = encodedWhatsAppUrl
} = Astro.props;
---

<section class="bg-mist">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-20">
    <div class="flex flex-col justify-center">
      <p class="text-sm font-bold uppercase tracking-wide text-accent-600">{eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal text-navy-900 sm:text-5xl">
        {title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">{description}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={primaryHref} class="rounded bg-navy-900 px-5 py-3 text-center text-sm font-bold text-white hover:bg-navy-800">
          {primaryLabel}
        </a>
        <a href={secondaryHref} target={secondaryHref.startsWith('http') ? '_blank' : undefined} rel={secondaryHref.startsWith('http') ? 'noopener noreferrer' : undefined} class="rounded border border-navy-900 px-5 py-3 text-center text-sm font-bold text-navy-900 hover:bg-white">
          {secondaryLabel}
        </a>
      </div>
      <p class="mt-6 text-sm font-semibold leading-7 text-slate-600">
        Clear process. Transparent pricing. Practical guidance. Reliable support for startups, freelancers, and growing businesses.
      </p>
    </div>
    <div class="grid content-center">
      <div class="rounded border border-slate-200 bg-white p-6 shadow-soft">
        <h2 class="text-xl font-bold text-navy-900">Services at a glance</h2>
        <div class="mt-5 grid gap-3 text-sm text-slate-700 sm:grid-cols-2">
          {['GST', 'Company Registration', 'Income Tax', 'FSSAI', 'Startup India', 'MSME/Udyam', 'GeM', 'ROC Filings'].map((item) => (
            <span class="rounded border border-slate-200 bg-slate-50 px-3 py-2 font-semibold">{item}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
