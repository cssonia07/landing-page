---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<section class="rounded border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-2xl font-bold tracking-normal text-navy-900">Process</h2>
  <ol class="mt-5 grid gap-4">
    {steps.map((step, index) => (
      <li class="flex gap-4 rounded border border-slate-200 bg-slate-50 p-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-navy-900 text-sm font-bold text-white">{index + 1}</span>
        <span class="pt-1 text-sm font-semibold leading-6 text-slate-700">{step}</span>
      </li>
    ))}
  </ol>
</section>
