---
import { encodedWhatsAppUrl, navigation, site } from '@data/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 flex-col" aria-label={`${site.name} home`}>
      <span class="text-base font-bold tracking-normal text-navy-900 sm:text-lg">{site.name}</span>
      <span class="hidden text-xs font-medium text-slate-500 sm:block">Practicing Company Secretary Firm</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-semibold transition hover:text-accent-600',
            currentPath === item.href ? 'text-accent-600' : 'text-slate-700'
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href={site.phoneHref} class="text-sm font-semibold text-navy-800 hover:text-accent-600">Call {site.phone}</a>
      <a
        href={encodedWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded bg-navy-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-navy-800"
      >
        WhatsApp
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded border border-slate-300 px-3 py-2 text-sm font-semibold text-navy-900">
        Menu
      </summary>
      <div class="absolute right-0 mt-3 w-72 rounded border border-slate-200 bg-white p-3 shadow-soft">
        <nav class="grid gap-1" aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded px-3 py-2 text-sm font-semibold',
                currentPath === item.href ? 'bg-navy-50 text-navy-900' : 'text-slate-700 hover:bg-slate-50'
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="mt-3 grid gap-2 border-t border-slate-200 pt-3">
          <a href={site.phoneHref} class="rounded border border-slate-300 px-3 py-2 text-center text-sm font-semibold text-navy-900">
            Call {site.phone}
          </a>
          <a
            href={encodedWhatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded bg-navy-900 px-3 py-2 text-center text-sm font-semibold text-white"
          >
            Talk on WhatsApp
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
