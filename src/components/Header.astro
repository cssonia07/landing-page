---
import { encodedWhatsAppUrl, navigation, site } from '@data/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 shadow-[0_1px_0_rgba(15,23,42,0.03)] backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 items-center" aria-label="NiyamDesk Home">
      <img
        src="/images/niyamdesk-logo.png"
        alt="NiyamDesk logo"
        class="h-10 w-auto md:h-12"
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-semibold transition hover:text-teal-600',
            currentPath === item.href ? 'text-teal-600' : 'text-slate-700'
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={site.phoneHref} class="text-sm font-semibold text-navy-800 transition hover:text-teal-600">Call {site.phone}</a>
      <a
        href={encodedWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-600"
      >
        Talk on WhatsApp
      </a>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-navy-900">
        Menu
      </summary>
      <div class="absolute right-0 mt-3 w-72 rounded-xl border border-slate-200 bg-white p-3 shadow-soft">
        <nav class="grid gap-1" aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-semibold',
                currentPath === item.href ? 'bg-teal-50 text-teal-700' : 'text-slate-700 hover:bg-slate-50 hover:text-teal-700'
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="mt-3 grid gap-2 border-t border-slate-200 pt-3">
          <a href={site.phoneHref} class="rounded-lg border border-slate-300 px-3 py-2 text-center text-sm font-semibold text-navy-900 hover:border-teal-500 hover:text-teal-700">
            Call {site.phone}
          </a>
          <a
            href={encodedWhatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-teal-500 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-teal-600"
          >
            Talk on WhatsApp
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
