---
import { encodedWhatsAppUrl, footerLinks, site } from '@data/site';
---

<footer class="border-t border-slate-200 bg-navy-900 text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div>
      <a href="/" class="text-xl font-bold">{site.name}</a>
      <p class="mt-3 max-w-xl text-sm leading-7 text-slate-300">
        Helping businesses stay compliant with simple, professional, and reliable support.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={site.phoneHref} class="rounded border border-white/20 px-4 py-2 text-sm font-semibold hover:bg-white/10">Call {site.phone}</a>
        <a href={encodedWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="rounded bg-accent-500 px-4 py-2 text-sm font-semibold text-navy-900 hover:bg-accent-600 hover:text-white">
          WhatsApp
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-300">Quick Links</h2>
      <nav class="mt-4 grid grid-cols-2 gap-2" aria-label="Footer navigation">
        {footerLinks.map((link) => (
          <a href={link.href} class="text-sm text-slate-300 hover:text-white">{link.label}</a>
        ))}
      </nav>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-300">Contact</h2>
      <address class="mt-4 not-italic text-sm leading-7 text-slate-300">
        <a href={site.phoneHref} class="block hover:text-white">Phone: {site.phone}</a>
        <a href={site.emailHref} class="block hover:text-white">Email: {site.email}</a>
        <span class="block">WhatsApp: {site.whatsapp}</span>
        <span class="block">Office: {site.location}</span>
      </address>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-5 text-center text-xs text-slate-400">
    © {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>
