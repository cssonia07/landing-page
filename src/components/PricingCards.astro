---
import SectionHeading from '@components/SectionHeading.astro';
import PricingCard from '@components/PricingCard.astro';

interface PricingItem {
  service: string;
  price: string;
  category: string;
  note?: string;
}

interface Props {
  items: PricingItem[];
  eyebrow?: string;
  title?: string;
  description?: string;
  note?: string;
  background?: 'white' | 'soft';
}

const {
  items,
  eyebrow,
  title,
  description,
  note = '*Government fees and third-party charges extra wherever applicable.',
  background = 'soft'
} = Astro.props;
---

<section class:list={[background === 'soft' ? 'bg-mist' : 'bg-white', 'section-pad']}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {title && <SectionHeading eyebrow={eyebrow} title={title} description={description} />}
    <div class:list={[title ? 'mt-10' : '', 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3']}>
      {items.map((item) => <PricingCard {...item} />)}
    </div>
    {note && (
      <p class="mt-8 rounded-xl border border-accent-500/30 bg-white p-4 text-sm font-semibold leading-7 text-slate-700 shadow-sm">
        {note}
      </p>
    )}
  </div>
</section>
