---
import { serviceWhatsAppUrl } from '@data/site';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel: string;
  secondaryLabel: string;
}

const { eyebrow = 'Professional Compliance Support', title, description, primaryLabel, secondaryLabel } = Astro.props;
---

<section class="bg-[linear-gradient(135deg,#ffffff_0%,#f8fafc_55%,#f0fdfa_100%)]">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-wide text-teal-700">{eyebrow}</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-normal text-navy-900 sm:text-5xl">{title}</h1>
      <p class="mt-5 text-base leading-8 text-slate-600 sm:text-lg">{description}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-primary">
          {primaryLabel}
        </a>
        <a href={serviceWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
