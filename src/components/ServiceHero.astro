---
import { serviceWhatsAppUrl } from '@data/site';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel: string;
  secondaryLabel: string;
}

const { eyebrow = 'Professional Compliance Support', title, description, primaryLabel, secondaryLabel } = Astro.props;
---

<section class="bg-mist">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-wide text-accent-600">{eyebrow}</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-normal text-navy-900 sm:text-5xl">{title}</h1>
      <p class="mt-5 text-base leading-8 text-slate-600 sm:text-lg">{description}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="rounded bg-navy-900 px-5 py-3 text-center text-sm font-bold text-white hover:bg-navy-800">
          {primaryLabel}
        </a>
        <a href={serviceWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="rounded border border-navy-900 px-5 py-3 text-center text-sm font-bold text-navy-900 hover:bg-white">
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
