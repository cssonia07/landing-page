---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  items: FAQ[];
  useChevronIcon?: boolean;
}

const { items, useChevronIcon = false } = Astro.props;
---

<div class="grid gap-3">
  {items.map((item) => (
    <details class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition open:border-teal-500/40 open:bg-teal-50/30">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-bold text-navy-900 transition group-open:text-teal-700">
        <span>{item.question}</span>
        {useChevronIcon ? (
          <span aria-hidden="true" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-teal-700 transition group-open:rotate-180">
            <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" focusable="false">
              <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" />
            </svg>
          </span>
        ) : (
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-teal-700 transition group-open:rotate-180">v</span>
        )}
      </summary>
      <p class="mt-3 text-sm leading-7 text-slate-600">{item.answer}</p>
    </details>
  ))}
</div>
