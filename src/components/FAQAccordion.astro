---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  items: FAQ[];
}

const { items } = Astro.props;
---

<div class="grid gap-3">
  {items.map((item) => (
    <details class="group rounded border border-slate-200 bg-white p-5">
      <summary class="cursor-pointer list-none text-base font-bold text-navy-900">
        {item.question}
      </summary>
      <p class="mt-3 text-sm leading-7 text-slate-600">{item.answer}</p>
    </details>
  ))}
</div>
