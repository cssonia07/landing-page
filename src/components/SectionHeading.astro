---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="text-sm font-bold uppercase tracking-wide text-accent-600">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-bold tracking-normal text-navy-900 sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-8 text-slate-600">{description}</p>}
</div>
