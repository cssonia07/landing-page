---
interface Props {
  pricing: string[];
  note: string;
}

const { pricing, note } = Astro.props;
---

<section class="premium-card border-accent-500/30 p-6">
  <h2 class="text-2xl font-bold tracking-normal text-navy-900">Pricing</h2>
  <div class="mt-5 grid gap-3">
    {pricing.map((item) => (
      <p class="rounded-lg border border-accent-500/25 bg-accent-50 p-4 text-base font-bold leading-7 text-navy-900">{item}</p>
    ))}
  </div>
  <p class="mt-4 text-sm leading-7 text-slate-600">{note}</p>
</section>
