---
const serviceOptions = [
  'GST Registration',
  'GST Return Filing',
  'GST Notice Support',
  'Company Registration',
  'LLP Registration',
  'OPC Registration',
  'Partnership Firm Registration',
  'Income Tax Return Filing',
  'FSSAI Registration',
  'Startup India Registration',
  'MSME/Udyam Registration',
  'GeM Registration',
  'IEC Registration',
  'ROC Filing / Annual Compliance',
  'FEMA Compliance',
  'Trademark Registration',
  'Tax Consultation',
  'Other Service'
];

const contactMethods = [
  'Phone Call',
  'WhatsApp',
  'Email'
];
---

<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact" class="grid gap-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-soft sm:p-8">
  <div class="h-1 w-16 rounded-full bg-teal-500"></div>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Do not fill this field <input name="bot-field" /></label>
  </p>
  <div>
    <label for="full-name" class="text-sm font-bold text-navy-900">Full Name</label>
    <input id="full-name" name="Full Name" type="text" required autocomplete="name" placeholder="Enter your full name" class="field-control" />
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="phone" class="text-sm font-bold text-navy-900">Phone Number</label>
      <input id="phone" name="Phone Number" type="tel" required autocomplete="tel" placeholder="Enter your mobile number" class="field-control" />
    </div>
    <div>
      <label for="email" class="text-sm font-bold text-navy-900">Email Address</label>
      <input id="email" name="Email Address" type="email" autocomplete="email" placeholder="Enter your email address" class="field-control" />
    </div>
  </div>
  <div>
    <label for="service" class="text-sm font-bold text-navy-900">Service Required</label>
    <select id="service" name="Service Required" required class="field-control">
      <option value="">Select a service</option>
      {serviceOptions.map((service) => <option value={service}>{service}</option>)}
    </select>
  </div>
  <div>
    <label for="message" class="text-sm font-bold text-navy-900">Message</label>
    <textarea id="message" name="Message" rows="5" required placeholder="Briefly describe your requirement" class="field-control"></textarea>
  </div>
  <div>
    <label for="preferred-contact-method" class="text-sm font-bold text-navy-900">Preferred Contact Method</label>
    <select id="preferred-contact-method" name="Preferred Contact Method" required class="field-control">
      <option value="">Select contact method</option>
      {contactMethods.map((method) => <option value={method}>{method}</option>)}
    </select>
  </div>
  <button type="submit" class="btn-primary">
    Submit Inquiry
  </button>
</form>
