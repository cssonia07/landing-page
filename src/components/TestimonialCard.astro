---
interface Props {
  title: string;
  quote: string;
  author: string;
}

const { title, quote, author } = Astro.props;
---

<figure class="premium-card h-full p-6">
  <div class="mb-4 h-1 w-12 rounded-full bg-accent-500"></div>
  <blockquote>
    <p class="text-lg font-bold text-navy-900">"{title}"</p>
    <p class="mt-4 text-sm leading-7 text-slate-600">"{quote}"</p>
  </blockquote>
  <figcaption class="mt-5 border-t border-slate-100 pt-4 text-sm font-bold text-slate-800">- {author}</figcaption>
</figure>
