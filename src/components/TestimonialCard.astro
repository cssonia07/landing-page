---
interface Props {
  title: string;
  quote: string;
  author: string;
}

const { title, quote, author } = Astro.props;
---

<figure class="h-full rounded border border-slate-200 bg-white p-6 shadow-sm">
  <blockquote>
    <p class="text-lg font-bold text-navy-900">“{title}”</p>
    <p class="mt-4 text-sm leading-7 text-slate-600">“{quote}”</p>
  </blockquote>
  <figcaption class="mt-5 text-sm font-bold text-slate-800">— {author}</figcaption>
</figure>
