---
import { serviceWhatsAppUrl, site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Need Professional Help?',
  description = 'Tell us your requirement and we will guide you with the right process, documents, pricing, and timeline.'
} = Astro.props;
---

<section class="bg-navy-900">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-12 text-white sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-normal">{title}</h2>
      <p class="mt-3 text-sm leading-7 text-slate-300">{description}</p>
      <div class="mt-5 grid gap-2 text-sm text-slate-300 sm:grid-cols-3">
        <a href={site.phoneHref} class="hover:text-white">Phone: {site.phone}</a>
        <a href={site.serviceEmailHref} class="hover:text-white">Email: {site.serviceEmail}</a>
        <span>WhatsApp Support: Available</span>
      </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="rounded border border-white/30 px-5 py-3 text-center text-sm font-bold text-white hover:bg-white/10">
        Call Now
      </a>
      <a href={serviceWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="rounded bg-accent-500 px-5 py-3 text-center text-sm font-bold text-navy-900 hover:bg-accent-600 hover:text-white">
        Talk on WhatsApp
      </a>
    </div>
  </div>
</section>
