---
interface Highlight {
  title: string;
  text?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  body?: string[];
  highlightTitle?: string;
  highlightText?: string;
  highlights?: Highlight[];
  background?: 'white' | 'soft';
  headingLevel?: 'h1' | 'h2';
}

const {
  eyebrow = 'About NiyamDesk',
  title,
  description,
  body = [],
  highlightTitle = 'Professional Compliance Support',
  highlightText,
  highlights = [],
  background = 'white',
  headingLevel = 'h2'
} = Astro.props;

const HeadingTag = headingLevel;
---

<section class:list={[background === 'soft' ? 'bg-mist' : 'bg-white', 'section-pad']}>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-teal-700">{eyebrow}</p>
      <HeadingTag class="mt-3 text-3xl font-bold leading-tight tracking-normal text-navy-900 sm:text-4xl">
        {title}
      </HeadingTag>
      {description && <p class="mt-4 text-base leading-8 text-slate-600">{description}</p>}
      {body.length > 0 && (
        <div class="mt-6 space-y-5 text-base leading-8 text-slate-600">
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}
    </div>

    <aside class="rounded-2xl border border-slate-200 bg-white p-6 shadow-soft">
      <div class="mb-5 h-1 w-14 rounded-full bg-accent-500"></div>
      <h3 class="text-xl font-bold text-navy-900">{highlightTitle}</h3>
      {highlightText && <p class="mt-3 text-sm leading-7 text-slate-600">{highlightText}</p>}
      {highlights.length > 0 && (
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {highlights.map((item) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-sm font-bold leading-6 text-navy-900">{item.title}</p>
              {item.text && <p class="mt-1 text-sm leading-6 text-slate-600">{item.text}</p>}
            </div>
          ))}
        </div>
      )}
    </aside>
  </div>
</section>
