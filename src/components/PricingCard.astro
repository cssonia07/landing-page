---
import { encodedWhatsAppUrl } from '@data/site';

interface Props {
  service: string;
  price: string;
  category: string;
}

const { service, price, category } = Astro.props;
---

<article class="rounded border border-slate-200 bg-white p-5 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-wide text-accent-600">{category}</p>
  <h3 class="mt-2 text-base font-bold text-navy-900">{service}</h3>
  <p class="mt-3 text-sm font-semibold text-slate-700">{price}</p>
  <a href={encodedWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded border border-navy-900 px-3 py-2 text-sm font-bold text-navy-900 hover:bg-navy-50">
    Ask for Scope
  </a>
</article>
