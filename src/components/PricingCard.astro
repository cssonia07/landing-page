---
import { encodedWhatsAppUrl } from '@data/site';

interface Props {
  service: string;
  price: string;
  category: string;
  note?: string;
}

const { service, price, category, note } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-teal-500/40 hover:shadow-soft">
  <div class="mb-5 h-1 w-14 rounded-full bg-teal-500"></div>
  <p class="inline-flex rounded-full bg-teal-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-teal-700">{category}</p>
  <h3 class="mt-3 text-base font-bold leading-6 text-navy-900">{service}</h3>
  <p class="mt-5 rounded-xl border border-accent-500/25 bg-accent-50 px-4 py-3 text-lg font-bold text-navy-900">{price}</p>
  {note && <p class="mt-3 text-sm leading-6 text-slate-600">{note}</p>}
  <a href={encodedWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex w-fit rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold text-navy-900 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-700">
    Ask for Scope
  </a>
</article>
